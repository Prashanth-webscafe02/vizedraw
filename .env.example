# Copy to .env.local (or set in your hosting provider) and fill in approved values.
# Unset destinations fall back to an explanatory dialog; nothing is invented.
VITE_APP_SIGNUP_URL=
VITE_APP_SIGNIN_URL=
VITE_CHECKOUT_STARTER_URL=
VITE_CHECKOUT_PRO_URL=
VITE_PRIVACY_URL=
VITE_TERMS_URL=
VITE_COOKIE_PREFERENCES_URL=
# Receives contact enquiries as JSON via POST. Without it, production builds
# show the submission error; `npm run dev` simulates success locally.
VITE_CONTACT_ENDPOINT=
